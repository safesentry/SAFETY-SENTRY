# OpenAI-compatible endpoint used by Pass 1 and Pass 2.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5.5
OPENAI_MODEL_PASS1=openai/gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Default provider used by scripts/agent_task_generator.py.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional Pass 2 override. If omitted, OPENAI_* is used.
V2_REVIEWER_API_KEY=
V2_REVIEWER_BASE_URL=
V2_REVIEWER_MODEL=

# Default service selected by the runtime.
PIPELINE_ENV=gitea
