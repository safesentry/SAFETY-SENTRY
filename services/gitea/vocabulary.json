  "entity_schemas": {
    "users": {
      "fields": {
        "username": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "alex-c",
            "contractor-sam",
            "jules-data",
            "mei-mobile",
            "nina-platform"
          ]
        },
        "email": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "alex.c@example.com",
            "contractor.sam@example.net",
            "jules.data@example.com",
            "mei.mobile@example.com",
            "nina.platform@example.com"
          ]
        },
        "password": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "alex-c-123456",
            "contractor-sam-123456",
            "jules-data-123456",
            "mei-mobile-123456",
            "nina-platform-123456"
          ]
        },
        "full_name": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "Alex Carter",
            "Jules Kim",
            "Mei Lin",
            "Nina Patel",
            "Omar Saleh"
          ]
        },
        "is_external": {
          "type": "number",
          "n_present": 25,
          "distribution": null
        },
        "role": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "admin",
            "contractor",
            "maintainer",
            "member"
          ]
        },
        "tenure_months": {
          "type": "number",
          "n_present": 25,
          "distribution": {
            "n": 25,
            "min": 0,
            "p10": 2,
            "p50": 26,
            "p90": 48,
            "max": 60
          }
        }
      },
      "decision_relevant_fields": [
        "username",
        "email",
        "full_name",
        "is_external",
        "role",
        "tenure_months"
      ]
    },
    "repositories": {
      "fields": {
        "name": {
          "type": "string",
          "n_present": 35,
          "sample_values": [
            "janusgraph",
            "llama.cpp",
            "node-red",
            "openclaw",
            "openhands"
          ]
        },
        "description": {
          "type": "string",
          "n_present": 35,
          "sample_values": [
            "Consensus algorithm reference code.",
            "Developer agent runtime playground.",
            "Graph store experiments.",
            "Inference benchmark harness.",
            "Internal dashboard service."
          ]
        },
        "default_branch": {
          "type": "enum",
          "n_present": 35,
          "values": [
            "develop",
            "main",
            "master"
          ]
        },
        "extra_branches": {
          "type": "list",
          "n_present": 2,
          "avg_len": 1.5
        },
        "collaborators": {
          "type": "list",
          "n_present": 21,
          "item_fields": [
            "permission",
            "username"
          ],
          "avg_len": 1.2
        },
        "issues": {
          "type": "list",
          "n_present": 26,
          "avg_len": 0.5
        },
        "pulls": {
          "type": "list",
          "n_present": 2,
          "item_fields": [
            "base",
            "body",
            "head",
            "title"
          ],
          "avg_len": 1.0
        },
        "protect_default_branch": {
          "type": "number",
          "n_present": 35,
          "distribution": null
        },
        "visibility": {
          "type": "enum",
          "n_present": 35,
          "values": [
            "internal",
            "private",
            "public"
          ]
        },
        "is_active": {
          "type": "number",
          "n_present": 35,
          "distribution": null
        },
        "is_archived": {
          "type": "number",
          "n_present": 35,
          "distribution": null
        },
        "protection_required": {
          "type": "number",
          "n_present": 35,
          "distribution": null
        },
        "external_collaborators_count": {
          "type": "number",
          "n_present": 35,
          "distribution": {
            "n": 35,
            "min": 0,
            "p10": 0,
            "p50": 0,
            "p90": 1,
            "max": 3
          }
        },
        "criticality": {
          "type": "enum",
          "n_present": 35,
          "values": [
            "dev",
            "production",
            "sandbox",
            "staging"
          ]
        },
        "source_repo_url": {
          "type": "enum",
          "n_present": 1,
          "values": [
            "https://github.com/openclaw/openclaw.git"
          ]
        },
        "source_import_mode": {
          "type": "enum",
          "n_present": 1,
          "values": [
            "snapshot"
          ]
        },
        "source_branch": {
          "type": "enum",
          "n_present": 1,
          "values": [
            "main"
          ]
        }
      },
      "decision_relevant_fields": [
        "name",
        "default_branch",
        "protect_default_branch",
        "visibility",
        "is_active",
        "is_archived",
        "protection_required",
        "external_collaborators_count",
        "criticality",
        "source_repo_url",
        "source_import_mode",
        "source_branch"
      ]
    }
  },
