        "domain"
      ]
    },
    "seed_emails": {
      "fields": {
        "from": {
          "type": "enum",
          "n_present": 7,
          "values": [
            "alice@example.com",
            "bob@example.com",
            "charlie@corp.example.com",
            "legal@legal.example.com",
            "marta.rossi@example.com",
