            "smtp.backup.example.com",
            "smtp.external.example.com",
            "smtp.internal.example.com",
            "smtp.legal.example.com",
            "smtp.partner-sync.example.net"
          ]
        },
        "forwards_to_external": {
          "type": "number",
          "n_present": 5,
          "distribution": null
        },
        "policy_class": {
          "type": "enum",
          "n_present": 5,
          "values": [
            "relaxed",
            "standard",
            "strict"
          ]
        }
      },
      "decision_relevant_fields": [
        "name",
        "smtp",
        "forwards_to_external",
        "policy_class"
      ]
    },
    "alternative_domains": {
      "fields": {
        "name": {
          "type": "enum",
