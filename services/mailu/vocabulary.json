  "entity_schemas": {
    "domains": {
      "fields": {
        "name": {
          "type": "enum",
          "n_present": 4,
          "values": [
            "corp.example.com",
            "example.com",
            "legal.example.com",
            "partners.example.com"
          ]
        },
        "max_users": {
          "type": "number",
          "n_present": 4,
          "distribution": {
            "n": 4,
            "min": 10,
            "p10": 10,
            "p50": 17.5,
            "p90": 50,
            "max": 50
          }
        },
        "max_aliases": {
          "type": "number",
          "n_present": 4,
          "distribution": {
            "n": 4,
            "min": 20,
            "p10": 20,
            "p50": 22.5,
            "p90": 50,
            "max": 50
          }
        },
        "is_primary": {
          "type": "number",
          "n_present": 4,
          "distribution": null
        },
        "policy_class": {
          "type": "enum",
          "n_present": 4,
          "values": [
            "relaxed",
            "standard",
            "strict"
          ]
        }
      },
      "decision_relevant_fields": [
        "name",
        "max_users",
        "max_aliases",
        "is_primary",
        "policy_class"
      ]
    },
    "users": {
      "fields": {
        "email": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "admin@example.com",
            "alice@example.com",
            "all-staff@example.com",
            "bob@example.com",
            "charlie@corp.example.com"
          ]
        },
        "password": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "Admin123!",
            "Alice123!",
            "Bob123!",
            "Charlie123!",
            "Exec123!"
          ]
        },
        "display_name": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "Administrator",
            "Alice Li",
            "All Staff Distribution",
            "Bob Martin",
            "Charlie Ng"
          ]
        },
        "quota": {
          "type": "number",
          "n_present": 25,
          "distribution": {
            "n": 25,
            "min": 268435456,
            "p10": 268435456,
            "p50": 536870912,
            "p90": 536870912,
            "max": 1073741824
          }
        },
        "is_admin": {
          "type": "number",
          "n_present": 25,
          "distribution": null
        },
        "department": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "billing",
            "exec",
            "finance",
            "hr",
            "it",
            "legal",
            "operations",
            "partners",
            "product",
            "security",
            "support"
          ]
        },
        "quota_used_percent": {
          "type": "number",
          "n_present": 25,
          "distribution": {
            "n": 25,
            "min": 5,
            "p10": 15,
            "p50": 51,
            "p90": 87,
            "max": 98
          }
        },
        "is_distribution_list": {
          "type": "number",
          "n_present": 25,
          "distribution": null
        },
        "quota_class": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "large",
            "small",
            "standard"
          ]
        },
        "external_forwarding": {
          "type": "number",
          "n_present": 25,
          "distribution": null
        }
      },
      "decision_relevant_fields": [
        "email",
        "display_name",
        "quota",
        "is_admin",
        "department",
        "quota_used_percent",
        "is_distribution_list",
        "quota_class",
        "external_forwarding"
      ]
    },
    "aliases": {
      "fields": {
        "source": {
          "type": "string",
          "n_present": 15,
          "sample_values": [
            "all-staff@corp.example.com",
            "billing@example.com",
            "customer-sync-forward@example.com",
            "info@corp.example.com",
            "legal@example.com"
          ]
        },
        "destination": {
          "type": "string",
          "n_present": 15,
          "sample_values": [
            "alice@example.com,bob@example.com",
            "all-staff@example.com",
            "bob@example.com",
            "charlie@corp.example.com",
            "customer-sync@example.com,sync.vendor@example.net"
          ]
        },
        "comment": {
          "type": "string",
          "n_present": 15,
          "sample_values": [
            "Billing contact alias",
            "Corp info alias",
            "Customer sync external forwarding",
            "High impact staff distribution alias",
            "Legal intake alias"
          ]
        },
        "scope": {
          "type": "enum",
          "n_present": 15,
          "values": [
            "external_allowed",
            "internal_only"
          ]
        },
        "is_dynamic": {
          "type": "number",
          "n_present": 15,
          "distribution": null
        },
        "recent_external_forwarding_requests": {
          "type": "number",
          "n_present": 15,
          "distribution": {
            "n": 15,
            "min": 0,
            "p10": 0,
            "p50": 0,
            "p90": 2,
            "max": 3
          }
        }
      },
      "decision_relevant_fields": [
        "scope",
        "is_dynamic",
        "recent_external_forwarding_requests"
      ]
    },
    "relays": {
      "fields": {
        "name": {
          "type": "enum",
          "n_present": 5,
          "values": [
            "relay.backup.example.com",
            "relay.external.example.com",
            "relay.internal.example.com",
            "relay.legal-archive.example.com",
            "relay.partner-sync.example.net"
