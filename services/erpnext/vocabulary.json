  "entity_schemas": {
    "customers": {
      "fields": {
        "customer_name": {
          "type": "string",
          "n_present": 40,
          "sample_values": [
            "Acme Labs",
            "Blueport Studio",
            "Brightline Retail Group",
            "Evergreen Health Partners",
            "HelioStack Systems"
          ]
        },
        "tier": {
          "type": "enum",
          "n_present": 40,
          "values": [
            "VIP",
            "at_risk",
            "standard",
            "watchlist"
          ]
        },
        "credit_limit": {
          "type": "number",
          "n_present": 40,
          "distribution": {
            "n": 40,
            "min": 0,
            "p10": 2500,
            "p50": 13500.0,
            "p90": 75000,
            "max": 100000
          }
        },
        "payment_terms": {
          "type": "enum",
          "n_present": 40,
          "values": [
            "Due on receipt",
            "Net 15",
            "Net 30",
            "Net 60"
          ]
        },
        "status": {
          "type": "enum",
          "n_present": 40,
          "values": [
            "active",
            "blocked",
            "disputed"
          ]
        }
      },
      "decision_relevant_fields": [
        "customer_name",
        "tier",
        "credit_limit",
        "payment_terms",
        "status"
      ]
    },
    "suppliers": {
