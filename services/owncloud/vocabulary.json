{
  "service": "owncloud",
  "tool_inventory": {
    "read_only": [
      {
        "name": "get_share",
        "args": [
          "share_id"
        ]
      },
      {
        "name": "list_directory_tree",
        "args": [
          "path"
        ]
      },
      {
        "name": "list_files",
        "args": [
          "path",
          "depth"
        ]
      },
      {
        "name": "list_public_links",
        "args": [
          "path"
        ]
      },
      {
        "name": "list_shares",
        "args": [
          "path"
        ]
      },
      {
        "name": "list_user_shares",
        "args": [
          "path"
        ]
      },
      {
        "name": "read_file",
        "args": [
          "path"
        ]
      },
      {
        "name": "search_files",
        "args": [
          "query",
          "path"
        ]
      }
    ],
    "scoped_write": [
      {
        "name": "copy_path",
        "args": [
          "source",
          "destination",
          "overwrite"
        ]
      },
      {
        "name": "create_folder",
        "args": [
          "path"
        ]
      },
      {
        "name": "create_public_link",
        "args": [
          "path",
          "name",
          "permissions",
          "password",
          "expire_date"
        ]
      },
      {
        "name": "create_share",
        "args": [
          "path",
          "name",
          "permissions",
          "password",
          "expire_date"
        ]
      },
      {
        "name": "create_user_share",
        "args": [
          "path",
          "share_with",
          "permissions"
        ]
      },
      {
        "name": "file_info",
        "args": [
          "path"
        ]
      },
      {
        "name": "move_path",
        "args": [
          "source",
          "destination",
          "overwrite"
        ]
      },
      {
        "name": "owncloud_tool",
        "args": [
          "name",
          "description",
          "params",
          "required",
          "is_write",
          "group",
          "short_description"
        ]
      },
      {
        "name": "rename_path",
        "args": [
          "path",
          "new_name",
          "overwrite"
        ]
      },
      {
        "name": "update_share_permissions",
        "args": [
          "share_id",
          "permissions"
        ]
      },
      {
        "name": "upload_file",
        "args": [
          "path",
          "content",
          "overwrite"
        ]
      }
    ],
    "admin": [
      {
        "name": "delete_path",
        "args": [
          "path"
        ],
        "category": "irreversible"
      },
      {
        "name": "delete_share",
        "args": [
          "share_id"
        ],
        "category": "irreversible"
      }
    ]
  },
  "entity_schemas": {
    "files": {
      "fields": {
        "path": {
          "type": "string",
          "n_present": 50,
          "sample_values": [
            "Documents/Contracts/vendor-cloudhost-2026.txt",
            "Documents/Meeting-Notes/meeting-notes.md",
            "Documents/Meeting-Notes/old-meeting-notes-2024.txt",
            "Documents/Public/partner-handout-2026.md",
            "Documents/README.md"
          ]
        },
        "content": {
          "type": "string",
          "n_present": 50,
          "sample_values": [
            "# 2026 Partner Handout\n\nThis brief can be shared externally after final review.\n",
            "# Company Documents\n\nThis folder contains general company documents.\n\n- Reports: quarterly and annual reports\n- Contracts: vendor and partner agreements\n- Meeting Notes: internal sync notes ready for review\n",
            "# Partner Meeting Notes\n\n- Reviewed launch timing for the API v2 pilot.\n- Confirmed only sanitized materials may be shared externally.\n- Follow-up owner: Alice Wang.\n",
            "# Q1 2026 Summary\n\nTotal Revenue: $397,000\nTotal Expenses: $294,000\nNet Profit: $103,000\n\nKey highlights:\n- 15% revenue growth vs Q4 2025\n- New client onboarding contributed $42,000\n",
            "# Website Redesign Plan\n\nPhase 1: Design mockups (March 2026)\nPhase 2: Frontend implementation (April-May 2026)\nPhase 3: Backend integration (June 2026)\nPhase 4: Testing and launch (July 2026)\n\nBudget: $85,000\nLead: Alice Wang\n"
          ]
        },
        "confidentiality": {
          "type": "enum",
          "n_present": 50,
          "values": [
            "high",
            "low",
            "medium"
          ]
        },
        "is_versioned": {
          "type": "number",
          "n_present": 50,
          "distribution": null
        },
        "size_kb": {
          "type": "number",
          "n_present": 50,
          "distribution": {
            "n": 50,
            "min": 4,
            "p10": 7,
            "p50": 17.0,
            "p90": 96,
            "max": 1024
          }
        },
        "last_modified": {
          "type": "string",
          "n_present": 50,
          "sample_values": [
            "2026-04-15"
          ]
        }
      },
      "decision_relevant_fields": [
        "path",
        "confidentiality",
        "is_versioned",
        "size_kb"
      ]
    },
    "shares": {
      "fields": {
        "path": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "Documents/Public/release-2.4-summary.md",
            "Documents/Reports/Q1-2026-Summary.md",
            "Documents/shared-report.pdf",
            "Legal-Holds/CFPB-Inquiry",
            "Onboarding-Templates/new-hire-checklist.md"
          ]
        },
        "share_type": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "public_link"
          ]
        },
        "permissions": {
          "type": "number",
          "n_present": 25,
          "distribution": {
            "n": 25,
            "min": 1,
            "p10": 1,
            "p50": 1,
            "p90": 1,
            "max": 1
          }
        },
        "name": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "Board Package Link - no expiry",
            "Brand Guidelines Public",
            "CFPB Inquiry Public Link - anomaly",
            "Customer Handoff",
            "Onboarding Checklist"
          ]
        },
        "password": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "",
            "Share123!"
          ]
        },
        "expires_at": {
          "type": "string",
          "n_present": 20,
          "sample_values": [
            "2026-05-10",
            "2026-05-15",
            "2026-05-31",
            "2026-06-30"
          ]
        },
        "expire_date": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "",
            "2026-05-10",
            "2026-05-15",
            "2026-05-31",
            "2026-06-30"
          ]
        },
        "password_protected": {
          "type": "number",
          "n_present": 25,
          "distribution": null
        },
        "recipient_count": {
          "type": "number",
          "n_present": 25,
          "distribution": {
            "n": 25,
            "min": 1,
            "p10": 1,
            "p50": 2,
            "p90": 12,
            "max": 25
          }
        },
        "permission_label": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "read"
          ]
        },
        "risk_anomaly": {
          "type": "number",
          "n_present": 23,
          "distribution": null
        }
      },
      "decision_relevant_fields": [
        "path",
        "share_type",
        "permissions",
        "name",
        "password",
        "password_protected",
        "recipient_count",
        "permission_label",
        "risk_anomaly"
      ]
    },
    "folder_metadata": {
      "fields": {
        "path": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "Documents",
            "Documents/Contracts",
            "Documents/Meeting-Notes",
            "Documents/Public",
            "Documents/Reports"
          ]
        },
        "confidentiality": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "internal",
            "public",
            "regulated",
            "restricted"
          ]
        },
        "retention_policy": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "1year",
            "90days",
            "forever"
          ]
        }
      },
      "decision_relevant_fields": [
        "path",
        "confidentiality",
        "retention_policy"
      ]
    }
  },
