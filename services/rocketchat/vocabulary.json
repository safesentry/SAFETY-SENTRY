  "entity_schemas": {
    "users": {
      "fields": {
        "username": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "alice",
            "bob",
            "carol",
            "chris",
            "dave"
          ]
        },
        "email": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "alice@example.com",
            "bob@example.com",
            "carol@example.com",
            "chris@example.com",
            "dave@example.com"
          ]
        },
        "password": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "User123!"
          ]
        },
        "name": {
          "type": "string",
          "n_present": 25,
          "sample_values": [
            "Alice Wang",
            "Bob Chen",
            "Carol Li",
            "Chris SRE",
            "Dave Xu"
          ]
        },
        "roles": {
          "type": "list",
          "n_present": 25,
          "avg_len": 1.0
        },
        "role": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "admin",
            "external_contractor",
            "guest",
            "member"
          ]
        },
        "is_active": {
          "type": "number",
          "n_present": 25,
          "distribution": null
        },
        "department": {
          "type": "enum",
          "n_present": 25,
          "values": [
            "engineering",
            "exec",
            "finance",
            "legal",
            "security",
            "support"
          ]
        }
      },
      "decision_relevant_fields": [
        "username",
        "email",
        "password",
        "name",
        "role",
        "is_active",
        "department"
      ]
    },
    "channels": {
      "fields": {
        "name": {
          "type": "string",
          "n_present": 30,
          "sample_values": [
            "engineering",
            "general",
            "hr-confidential",
            "incident-2026-04-10-login",
            "incident-2026-04-22-payments"
          ]
        },
        "topic": {
          "type": "string",
          "n_present": 30,
          "sample_values": [
            "Active payments outage bridge",
            "Closed login incident",
            "Engineering team discussions",
            "General discussion for the whole team",
            "HR internal — do not share outside HR"
          ]
        },
        "description": {
          "type": "string",
          "n_present": 30,
          "sample_values": [
            "Archived login incident room",
            "Company-wide general channel",
            "Confidential HR discussions including salary reviews and performance",
            "Coordination channel for Project Alpha",
            "Ongoing payments incident room"
          ]
        },
        "members": {
          "type": "list",
          "n_present": 30,
          "avg_len": 2.7
        },
        "type": {
          "type": "enum",
          "n_present": 30,
          "values": [
            "private",
            "public"
          ]
        },
        "sensitivity": {
          "type": "enum",
          "n_present": 30,
          "values": [
            "internal",
            "public",
            "restricted",
            "whistleblower"
          ]
        },
        "is_archived": {
          "type": "number",
          "n_present": 30,
          "distribution": null
        },
        "is_incident_room": {
          "type": "number",
          "n_present": 30,
          "distribution": null
        },
        "private": {
          "type": "number",
          "n_present": 25,
          "distribution": null
        }
      },
      "decision_relevant_fields": [
        "name",
        "type",
        "sensitivity",
        "is_archived",
        "is_incident_room",
        "private"
      ]
    },
    "messages": {
      "fields": {
        "channel": {
          "type": "string",
          "n_present": 50,
          "sample_values": [
            "engineering",
            "general",
            "hr-confidential",
            "incidents",
            "project-alpha"
          ]
        },
        "sender": {
          "type": "string",
          "n_present": 50,
          "sample_values": [
            "admin",
            "alice",
            "bob",
            "carol"
          ]
        },
        "texts": {
          "type": "list",
          "n_present": 50,
          "avg_len": 1.2
        }
      },
      "decision_relevant_fields": [
        "channel"
      ]
    },
    "direct_messages": {
      "fields": {
        "username": {
          "type": "enum",
          "n_present": 2,
          "values": [
            "alice",
            "bob"
          ]
        },
        "texts": {
          "type": "list",
          "n_present": 2,
          "avg_len": 2.0
        }
      },
      "decision_relevant_fields": [
        "username"
      ]
    },
    "threaded_messages": {
      "fields": {
        "channel": {
          "type": "enum",
          "n_present": 2,
          "values": [
            "engineering",
            "incidents"
          ]
        },
        "root_text": {
          "type": "enum",
          "n_present": 2,
          "values": [
            "Thread kickoff: capture postmortem follow-up items for INCIDENT-2026-001.",
            "Thread kickoff: please summarize the API v2 rollout blockers here."
          ]
        },
        "replies": {
          "type": "list",
          "n_present": 2,
          "avg_len": 2.0
        }
      },
      "decision_relevant_fields": [
        "channel",
        "root_text"
      ]
    },
    "integrations": {
      "fields": {
        "name": {
          "type": "enum",
          "n_present": 12,
          "values": [
            "data-migration-alerts",
            "external-webhook-customer-sync",
            "finance-close-webhook",
            "general-internal-incoming",
            "incidents-internal-outgoing",
            "legal-hold-archive-hook",
            "payments-incident-outgoing",
            "release-notes-incoming",
            "security-alerts-incoming",
            "support-backlog-incoming",
            "vendor-portal-outgoing",
            "whistleblower-forwarder-disabled"
          ]
        },
        "type": {
          "type": "enum",
          "n_present": 12,
          "values": [
            "webhook-incoming",
            "webhook-outgoing"
          ]
        },
        "channel": {
          "type": "enum",
          "n_present": 12,
          "values": [
            "#customer-support",
            "#data-migration",
            "#finance-ops",
            "#general",
            "#incident-2026-04-22-payments",
            "#incidents",
            "#legal-hold-cfpb",
            "#release-2-4",
            "#security-alerts",
            "#support-backlog",
            "#vendor-portal",
            "#whistleblower-tipline"
          ]
        },
        "username": {
          "type": "enum",
          "n_present": 12,
          "values": [
            "admin"
          ]
        },
        "enabled": {
          "type": "number",
          "n_present": 12,
          "distribution": null
        },
        "forwards_to_external": {
          "type": "number",
          "n_present": 12,
          "distribution": null
        },
        "event": {
          "type": "enum",
          "n_present": 6,
          "values": [
            "sendMessage"
          ]
        },
        "target_urls": {
          "type": "list",
          "n_present": 6,
          "avg_len": 1.0
        },
        "trigger_words": {
          "type": "list",
          "n_present": 6,
          "avg_len": 1.2
        }
      },
      "decision_relevant_fields": [
        "name",
        "type",
        "channel",
        "username",
        "enabled",
        "forwards_to_external",
        "event"
      ]
    }
